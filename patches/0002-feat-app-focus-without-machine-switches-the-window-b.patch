From: preciselytord <54438880+preciselytord@users.noreply.github.com>
Date: Mon, 16 Nov 2026 15:36:38 +0100
Subject: [PATCH] feat: app focus without --machine switches the window back to
 this machine

`herdr app focus --pane <id>` only focused the local server, so a window
showing a saved machine stayed there. It now also sends client.activate_endpoint
with an empty machine, which the client shell resolves to the local endpoint,
and prints "focused (app)" when a running window took it.
---
 src/cli/app.rs                      | 18 ++++++++++-
 src/client/shell/endpoints.rs       |  6 ++--
 src/client/shell/tests/endpoints.rs | 23 ++++++++++++++
 tests/cli/app.rs                    | 48 +++++++++++++++++++++--------
 4 files changed, 80 insertions(+), 15 deletions(-)

diff --git a/src/cli/app.rs b/src/cli/app.rs
index 22f332ce..527ca391 100644
--- a/src/cli/app.rs
+++ b/src/cli/app.rs
@@ -217,6 +217,21 @@ fn local_focus(target: &ClientActivateEndpointTarget) -> std::io::Result<i32> {
         eprintln!("{}", serde_json::to_string(&response).unwrap());
         return Ok(1);
     }
+    // The window may be showing a saved machine; ask it to switch back to this
+    // machine as well. An empty selector names the local endpoint.
+    let activation = Request {
+        id: "cli:app:focus:local".into(),
+        method: Method::ClientActivateEndpoint(ClientActivateEndpointParams {
+            machine: String::new(),
+            target: target.clone(),
+        }),
+    };
+    if super::send_request_unchecked(&activation)
+        .is_ok_and(|response| activation_delivered(&response))
+    {
+        println!("{FOCUSED_APP}");
+        return Ok(0);
+    }
     println!("{FOCUSED_LOCAL}");
     Ok(0)
 }
@@ -227,7 +242,8 @@ fn print_app_help() {
         "  herdr app focus [--machine <label-or-id>] (--pane <id> | --tab <id> | --workspace <id>)"
     );
     eprintln!("    Jump a running app to the target. With --machine it switches the app");
-    eprintln!("    to that saved machine; without one it focuses the local target.");
+    eprintln!("    to that saved machine; without one it switches the app back to this");
+    eprintln!("    machine and focuses the local target.");
 }
 
 #[cfg(test)]
